# ---------- SERVER SETTINGS ----------
PORT=5000
NODE_ENV=development

# ---------- CLIENT URL ----------
# Local development frontend URL. In production, add your Render frontend URL.
CLIENT_URL=http://localhost:3000
# Optional comma-separated extra origins, for example custom domains.
CORS_ORIGINS=https://your-frontend.onrender.com

# ---------- DATABASE ----------
# Replace with your actual MongoDB URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ---------- AUTHENTICATION & SECURITY ----------
# Provide a strong random string (e.g., generate using `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d
ADMIN_SECRET_KEY=your_super_secret_admin_key

# ---------- IMAGE HOSTING (CLOUDINARY) ----------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------- EMAIL NOTIFICATIONS ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
